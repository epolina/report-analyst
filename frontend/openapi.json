{
  "openapi": "3.1.0",
  "info": {
    "title": "Report analyst",
    "version": "0.1.0"
  },
  "paths": {
    "/uploads": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Upload",
        "description": "Add an annual report PDF, asking first about a duplicate, and start processing it.\n\nProcessing runs in the background: poll `GET /reports` until the report's status is success\nor failed. One report is processed at a time; a second one waits its turn.\n\nArgs:\n    settings: The app settings.\n    service: Stores the report, then extracts its FTE and goals.\n    file: The annual report PDF.\n    company_name: The Company the report belongs to, as entered by the user.\n    reporting_year: The Reporting Year the report covers.\n    on_duplicate: What to do when a report for this Company and year is stored; None asks\n        first with a 409 `same_company_year`.\n\nReturns:\n    The stored report, processing.\n\nRaises:\n    ApiError: 409 `same_file`, `same_company_year` or `still_processing`, naming the stored\n        report; 413 `file_too_large`; 415 `not_a_pdf`; 422 `unreadable_pdf` if pdfium\n        can't open it. Missing or invalid fields get FastAPI's own 422 validation error.",
        "operationId": "upload_uploads_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_uploads_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExistingReportOut"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooLargeOut"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "List Reports",
        "description": "List all stored reports.\n\nArgs:\n    repository: Where reports are stored.\n\nReturns:\n    The reports, by Company and then year.",
        "operationId": "list_reports_reports_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Report"
                  },
                  "type": "array",
                  "title": "Response List Reports Reports Get"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{report_id}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Report",
        "description": "Get a report with its FTE and Sustainability Goals.\n\nThe Facts are extracted while the report is processed. A report that is processing or\nfailed has none yet: `fte` is null and `goals` empty.\n\nArgs:\n    report_id: The report's id.\n    repository: Where reports are stored.\n\nReturns:\n    The report and its facts.\n\nRaises:\n    ApiError: 404 `report_not_found`.",
        "operationId": "get_report_reports__report_id__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{report_id}/retry": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Retry Report",
        "description": "Process a failed report again, from the PDF it stored.\n\nArgs:\n    report_id: The report's id.\n    repository: Where reports are stored.\n    service: Processes the report in the background.\n\nReturns:\n    The report, processing.\n\nRaises:\n    ApiError: 404 `report_not_found`; 409 `not_failed`.",
        "operationId": "retry_report_reports__report_id__retry_post",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{report_id}/pages/{page_number}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Page",
        "description": "Get one page of a report as a JPEG image, rendered while it was processed.\n\nArgs:\n    report_id: The report's id.\n    page_number: The page number, starting at 1.\n    repository: Where the page images are stored.\n\nReturns:\n    The image.\n\nRaises:\n    ApiError: 404 `page_not_found`, also for an unknown report.",
        "operationId": "get_page_reports__report_id__pages__page_number__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Report Id"
            }
          },
          {
            "name": "page_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Page Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/jpeg": {}
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Ask",
        "description": "Answer a Question about the FTE or Sustainability Goals, with verbatim Evidence.\n\nNot Found is a normal answer (`kind: \"not_found\"`), not an error: also for a Company\nor year with no stored report, or a Question about anything else. Takes about 5-15 s.\n\nArgs:\n    request: The Question.\n    service: Answers it.\n\nReturns:\n    The Turn and its Conversation's id.\n\nRaises:\n    ApiError: 404 `conversation_not_found`; 502 `answer_failed` if Claude couldn't answer.",
        "operationId": "ask_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatReply"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "Get Conversation",
        "description": "Get a Conversation with all its Turns, to show it again after a reload.\n\nArgs:\n    conversation_id: Its id.\n    conversations: Where Conversations are stored.\n\nReturns:\n    The Conversation.\n\nRaises:\n    ApiError: 404 `conversation_not_found`.",
        "operationId": "get_conversation_conversations__conversation_id__get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Report that the service is up.\n\nReturns:\n    Always `{\"status\": \"ok\"}`.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "answer",
              "not_found"
            ],
            "title": "Kind"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/ChatEvidence"
            },
            "type": "array",
            "title": "Evidence",
            "default": []
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NotFoundReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "kind",
          "text"
        ],
        "title": "Answer",
        "description": "What the user sees for a Question: an answer with Evidence, or Not Found with a reason.\n\nAttributes:\n    kind: Whether the reports answered it.\n    text: Claude's plain text, never HTML; \"\" for a Not Found the app decided without\n        asking Claude, which the UI words from `reason`.\n    evidence: At least one for an answer; none for Not Found.\n    reason: Why it wasn't found; None for an answer.\n    missing: For `no_matching_report`, what the Question names that isn't stored, e.g.\n        \"ABN AMRO 2023\"; empty otherwise."
      },
      "Body_upload_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "company_name": {
            "type": "string",
            "minLength": 1,
            "title": "Company Name"
          },
          "reporting_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1900.0,
            "title": "Reporting Year"
          },
          "on_duplicate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OnDuplicate"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "file",
          "company_name",
          "reporting_year"
        ],
        "title": "Body_upload_uploads_post"
      },
      "ChatEvidence": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "boxes": {
            "items": {
              "$ref": "#/components/schemas/PageBox"
            },
            "type": "array",
            "title": "Boxes"
          },
          "report_id": {
            "type": "string",
            "format": "uuid",
            "title": "Report Id"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "reporting_year": {
            "type": "integer",
            "title": "Reporting Year"
          }
        },
        "type": "object",
        "required": [
          "page",
          "quote",
          "boxes",
          "report_id",
          "company_name",
          "reporting_year"
        ],
        "title": "ChatEvidence",
        "description": "Evidence for an Answer, naming its report, since one Question can search several.\n\nAttributes:\n    report_id: The report the quote is from.\n    company_name: Its Company.\n    reporting_year: Its Reporting Year."
      },
      "ChatReply": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/ReportRef"
            },
            "type": "array",
            "title": "Reports",
            "default": []
          },
          "answer": {
            "$ref": "#/components/schemas/Answer"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer",
          "conversation_id"
        ],
        "title": "ChatReply",
        "description": "The reply to a Question: its Turn, and the Conversation it was added to.\n\nAttributes:\n    conversation_id: The conversation, new if the Question started one."
      },
      "ChatRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "description": "A Question, in a new or an existing Conversation.\n\nAttributes:\n    conversation_id: The Conversation to continue; None starts one.\n    question: The Question. Its Company and year are read from it, or from the\n        earlier Questions for a follow-up."
      },
      "Conversation": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "type": "array",
            "title": "Turns",
            "default": []
          }
        },
        "type": "object",
        "title": "Conversation",
        "description": "The Turns of one chat, oldest first. Stored, so it survives a restart.\n\nAttributes:\n    conversation_id: The conversation's id.\n    turns: The Turns."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "report_not_found",
          "page_not_found",
          "conversation_not_found",
          "not_failed",
          "answer_failed",
          "file_too_large",
          "not_a_pdf",
          "unreadable_pdf",
          "still_processing",
          "same_file",
          "same_company_year"
        ],
        "title": "ErrorCode",
        "description": "What went wrong. Each route's `responses` lists the codes it can send."
      },
      "ErrorOut": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "ErrorOut",
        "description": "An error response.\n\nAttributes:\n    code: What went wrong."
      },
      "Evidence": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "boxes": {
            "items": {
              "$ref": "#/components/schemas/PageBox"
            },
            "type": "array",
            "title": "Boxes"
          }
        },
        "type": "object",
        "required": [
          "page",
          "quote",
          "boxes"
        ],
        "title": "Evidence",
        "description": "A verbatim quote from a Report, the page it is on and where on the page.\n\nAttributes:\n    page: The page number, starting at 1.\n    quote: The sentence or table row that states the fact, copied verbatim.\n    boxes: Where the quote is: the boxes of the paragraph or table holding it, to highlight\n        it."
      },
      "ExistingReportOut": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "existing": {
            "$ref": "#/components/schemas/Report"
          }
        },
        "type": "object",
        "required": [
          "code",
          "existing"
        ],
        "title": "ExistingReportOut",
        "description": "An error about a stored report: a duplicate, or one still processing. Nothing was saved.\n\nAttributes:\n    existing: The stored report."
      },
      "Fte": {
        "properties": {
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "evidence"
        ],
        "title": "Fte",
        "description": "The Company's total FTE (not headcount) for the Reporting Year.\n\nAttributes:\n    amount: The number of full-time equivalents.\n    evidence: Where the report states it."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health",
        "description": "Response of GET /health."
      },
      "NotFoundReason": {
        "type": "string",
        "enum": [
          "not_in_report",
          "report_not_ready",
          "no_report",
          "no_matching_report",
          "unsupported_topic"
        ],
        "title": "NotFoundReason",
        "description": "Why a Question has no Answer."
      },
      "OnDuplicate": {
        "type": "string",
        "enum": [
          "replace",
          "keep_both"
        ],
        "title": "OnDuplicate",
        "description": "What the user chose for an upload with the Company and year of a stored report."
      },
      "PageBox": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "width": {
            "type": "number",
            "title": "Width"
          },
          "height": {
            "type": "number",
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "PageBox",
        "description": "A rectangle on a page, as fractions of the page size from its top-left corner.\n\nAttributes:\n    x: The left edge, 0 to 1.\n    y: The top edge, 0 to 1.\n    width: The width, 0 to 1.\n    height: The height, 0 to 1."
      },
      "Report": {
        "properties": {
          "report_id": {
            "type": "string",
            "format": "uuid",
            "title": "Report Id"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "reporting_year": {
            "type": "integer",
            "title": "Reporting Year"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "status": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportFailure"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "company_name",
          "reporting_year",
          "sha256",
          "page_count",
          "status"
        ],
        "title": "Report",
        "description": "One Company's annual report for one Reporting Year.\n\nAttributes:\n    report_id: The report's id. Kept when the report is replaced.\n    company_name: The Company, spelled as it was first entered for any report.\n    reporting_year: The Reporting Year.\n    sha256: The SHA-256 hash of the PDF, to spot the same file uploaded again.\n    page_count: The number of pages.\n    status: Where it is in processing.\n    failure: Why processing failed; None unless `status` is failed."
      },
      "ReportDetail": {
        "properties": {
          "report_id": {
            "type": "string",
            "format": "uuid",
            "title": "Report Id"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "reporting_year": {
            "type": "integer",
            "title": "Reporting Year"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "status": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "fte": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Fte"
              },
              {
                "type": "null"
              }
            ]
          },
          "goals": {
            "items": {
              "$ref": "#/components/schemas/SustainabilityGoal"
            },
            "type": "array",
            "title": "Goals"
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "company_name",
          "reporting_year",
          "sha256",
          "page_count",
          "status",
          "fte",
          "goals"
        ],
        "title": "ReportDetail",
        "description": "A report with the facts found in it.\n\nAttributes:\n    fte: The total FTE, or None if it wasn't found.\n    goals: The Sustainability Goals, in page order."
      },
      "ReportFailure": {
        "type": "string",
        "enum": [
          "unreadable_pdf",
          "facts_failed",
          "interrupted",
          "unexpected"
        ],
        "title": "ReportFailure",
        "description": "Why processing failed. The UI words it for the user."
      },
      "ReportRef": {
        "properties": {
          "report_id": {
            "type": "string",
            "format": "uuid",
            "title": "Report Id"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "reporting_year": {
            "type": "integer",
            "title": "Reporting Year"
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "company_name",
          "reporting_year"
        ],
        "title": "ReportRef",
        "description": "A stored report, named the way the UI shows it.\n\nAttributes:\n    report_id: The report's id.\n    company_name: Its Company.\n    reporting_year: Its Reporting Year."
      },
      "ReportStatus": {
        "type": "string",
        "enum": [
          "processing",
          "success",
          "failed"
        ],
        "title": "ReportStatus",
        "description": "Where a Report is in processing. Processing runs in the background after the upload."
      },
      "SustainabilityGoal": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "deadline": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "baseline": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          }
        },
        "type": "object",
        "required": [
          "title",
          "evidence"
        ],
        "title": "SustainabilityGoal",
        "description": "A sustainability target the Company has set.\n\nAttributes:\n    title: A short label for the user, e.g. \"Net-zero Scope 1 and 2 emissions by 2030\".\n        Written by the model; the quote is the proof.\n    deadline: The year the target must be met, if stated.\n    baseline: The year it's measured against, if stated.\n    evidence: Where the report states it."
      },
      "TooLargeOut": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "max_upload_mb": {
            "type": "integer",
            "title": "Max Upload Mb"
          }
        },
        "type": "object",
        "required": [
          "code",
          "max_upload_mb"
        ],
        "title": "TooLargeOut",
        "description": "The upload is over the size limit.\n\nAttributes:\n    max_upload_mb: The limit, in MB."
      },
      "Turn": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/ReportRef"
            },
            "type": "array",
            "title": "Reports",
            "default": []
          },
          "answer": {
            "$ref": "#/components/schemas/Answer"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "Turn",
        "description": "One Question and its Answer.\n\nAttributes:\n    question: As the user typed it.\n    reports: The reports the Question was matched to and answered from; empty if none\n        matched.\n    answer: The Answer."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
