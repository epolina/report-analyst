# Copy to .env and fill in. VS Code terminals load .env automatically.
# Run the backend from backend/: uv run --env-file ../.env uvicorn report_analyst.main:app --reload
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Optional, defaults shown.
# REPORTS_DIR=data/reports
# CONVERSATIONS_DIR=data/conversations
# ANTHROPIC_MODEL=claude-opus-5-5
# MAX_UPLOAD_MB=100
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   (changing it means uploading every report again)
# MODELS_DIR=../models   (relative to backend/; the Docker image sets /app/models)
